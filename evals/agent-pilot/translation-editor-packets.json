{
  "packets": [
    {
      "role": "editor",
      "locale": "hu",
      "entries": [
        {
          "id": "s001",
          "text": "Mielőtt olyasmit vennék, ami jövő hónapban már nem számít, megállok egy pillanatra.",
          "kind": "authored",
          "display_role": "quote card",
          "fit": "not_checked"
        },
        {
          "id": "s002",
          "text": "Ha egy döntés várhat, nem sietek a költekezéssel.",
          "kind": "authored",
          "display_role": "quote card",
          "fit": "not_checked"
        },
        {
          "id": "s003",
          "text": "A költségvetésemet térképnek használom, nem büntetésnek.",
          "kind": "authored",
          "display_role": "quote card",
          "fit": "not_checked"
        },
        {
          "id": "s004",
          "text": "A jólét számomra teret ad arra, hogy mások hasznára legyek.",
          "kind": "authored",
          "display_role": "quote card",
          "fit": "not_checked"
        },
        {
          "id": "s005",
          "text": "Senki ne mondja meg, hogyan érezzek önmagammal kapcsolatban; csak én dönthetem el, ki vagyok, és milyen életet szeretnék.",
          "kind": "authored",
          "display_role": "quote card",
          "fit": "not_checked"
        },
        {
          "id": "s006",
          "text": "Megérdemled a tiszteletet, miközben fejlődsz, {userName}.",
          "kind": "authored",
          "display_role": "quote card",
          "fit": "not_checked"
        }
      ],
      "revision_token": "5ff8115a042848e6a1f6eaa52a53a2aa",
      "packet_hash": "45af73116ce756a46dfa2188bd3f26b2674cda959d82674cfa22eff491ee830a",
      "output_contract": {
        "packet_hash": "45af73116ce756a46dfa2188bd3f26b2674cda959d82674cfa22eff491ee830a",
        "reviewer": {
          "id": "actual-agent-id",
