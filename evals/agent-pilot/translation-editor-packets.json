          "kind": "authored",
          "display_role": "quote card",
          "fit": "not_checked"
        },
        {
          "id": "s004",
          "text": "Văd în prosperitate mai multă libertate de a fi de folos.",
          "kind": "authored",
          "display_role": "quote card",
          "fit": "not_checked"
        },
        {
          "id": "s005",
