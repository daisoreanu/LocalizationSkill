    {
      "role": "editor",
      "locale": "hu",
      "entries": [
        {
          "id": "s001",
          "text": "Ne kösd reményedet vagy félelmedet egyetlen hatalmas emberhez; őrizd meg ítéleted önállóságát.",
          "kind": "attributed",
          "display_role": "quote card",
          "fit": "not_checked"
        },
        {
          "id": "s002",
          "text": "A legtöbb dolgot, amit az életben megtanulsz, zűrzavaros, nem hatékony próbálkozások és tévedések útján tanulod majd meg.",
          "kind": "attributed",
          "display_role": "quote card",
          "fit": "not_checked"
        },
        {
          "id": "s003",
          "text": "Ne feledd, hogy a kudarc nem szükséges rossz — valójában egyáltalán nem rossz. Szükségszerű következménye annak, hogy valami újat csinálsz.",
          "kind": "attributed",
          "display_role": "quote card",
          "fit": "not_checked"
        }
      ],
      "revision_token": "99477cf65a5a46358cece54a8f1d27b6",
      "packet_hash": "3188ac756c4e5750298053419a2eb12b6b98b5c9a4307a449f0c95f43cf99fb5",
