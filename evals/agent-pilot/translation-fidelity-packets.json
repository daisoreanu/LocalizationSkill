      "role": "fidelity",
      "locale": "hu",
      "entries": [
        {
          "id": "s001",
          "text": "Ne kösd reményedet vagy félelmedet egyetlen hatalmas emberhez; őrizd meg ítéleted önállóságát.",
          "kind": "attributed",
          "display_role": "quote card",
          "fit": "not_checked",
          "source": {
            "id": "5BAC1CF4-9525-5D91-B604-0ACBD4CB0FE9",
            "category": "stoic",
            "text": "Do not put your hope or fear in one powerful person; keep your judgment your own.",
            "language": "en",
            "verification": "supplied_unverified",
            "theme": "wealth",
            "import": {
              "batch": "2026-09-14",
              "file": "Set4-stoic/test1.json",
              "row": 2,
              "text": "Do not put your hope or fear in one powerful person; keep your judgment your own.",
