              "title": "Ed Catmull: What You Can Learn About Creativity From Pixar",
              "published": "2014-04-08",
              "retrieved": "2026-08-18",
              "tier": "reputable_secondary",
              "verifiedBy": "refetch"
            },
            "verification": "sourced"
          },
          "candidate_hash": "c24b930e1fe4158323331e0c3951290d9aa59e73bb4392f6d7b93c81c6ddd9e4",
