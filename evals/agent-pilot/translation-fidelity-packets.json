        {
          "id": "s001",
          "text": "Megállok egy pillanatra, mielőtt olyasmit vennék, ami jövő hónapban már nem számít.",
          "kind": "authored",
          "display_role": "quote card",
          "fit": "not_checked",
          "source": {
