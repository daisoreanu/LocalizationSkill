      "entries": [
        {
          "id": "s001",
          "text": "Mă opresc înainte să cumpăr ceva ce nu va mai conta luna viitoare.",
          "kind": "authored",
          "display_role": "quote card",
          "fit": "not_checked",
          "source": {
            "id": "493E8AA1-BA54-52A3-94AE-DAD1DF2731D1",
            "category": "affirmations",
            "text": "I pause before buying what will not matter next month.",
            "attribution": null,
            "language": "en",
            "context": null,
            "theme": "financial",
            "pairId": "affirmations-0003",
            "source": null,
            "verification": "authored"
          },
          "candidate_hash": "c1016339924b830348823ca63e43de6bb1980d4578ad2411167350201334c069",
          "canonical": null
        },
        {
          "id": "s002",
          "text": "Nu mă grăbesc să cheltuiesc când decizia poate aștepta.",
          "kind": "authored",
          "display_role": "quote card",
          "fit": "not_checked",
          "source": {
            "id": "8B6A7736-3584-5415-84AE-47FB022AD2F0",
            "category": "affirmations",
            "text": "I spend slowly when a decision can wait.",
            "attribution": null,
            "language": "en",
            "context": null,
            "theme": "financial",
            "pairId": "affirmations-0012",
            "source": null,
            "verification": "authored"
          },
          "candidate_hash": "10d5f7b2a62364ee9e0d938e2e0738fbbb9ad9710447c33b577dda75fe0579e3",
          "canonical": null
        },
        {
          "id": "s003",
          "text": "Îmi folosesc bugetul ca pe o hartă, nu ca pe o pedeapsă.",
          "kind": "authored",
          "display_role": "quote card",
          "fit": "not_checked",
          "source": {
            "id": "2B6BB4B5-9C4A-58DB-8536-3D0481193BA8",
            "category": "affirmations",
            "text": "I use my budget as a map, not a punishment.",
            "attribution": null,
            "language": "en",
            "context": null,
            "theme": "financial",
            "pairId": "affirmations-0053",
            "source": null,
            "verification": "authored"
          },
          "candidate_hash": "b455201f50058b407d9237c17a5ad8ccf233148c4e0708d9109b31755f733dd7",
          "canonical": null
        },
        {
          "id": "s004",
          "text": "Văd bogăția ca pe un spațiu în care pot fi de folos.",
          "kind": "authored",
          "display_role": "quote card",
          "fit": "not_checked",
          "source": {
            "id": "A4B08362-CB12-5387-926A-3EC5205F0851",
            "category": "affirmations",
            "text": "I see wealth as room to be useful.",
            "attribution": null,
            "language": "en",
            "context": null,
            "theme": "wealth_mindset",
            "pairId": "affirmations-0075",
            "source": null,
            "verification": "authored"
          },
          "candidate_hash": "1e1eea6dd4363e586c43d689ff81edbb9f7a39b30dfda6e3f421fad73bbb5d83",
          "canonical": null
        },
        {
          "id": "s005",
          "text": "Nimeni nu ar trebui să-mi spună vreodată ce simt despre mine; doar eu decid cine sunt și ce fel de viață îmi doresc.",
          "kind": "authored",
          "display_role": "quote card",
          "fit": "not_checked",
          "source": {
            "id": "D24FAFF0-1061-58C1-9260-CFA2F7477FE3",
            "category": "affirmations",
            "text": "No one should ever tell me how I feel about myself; only I get to decide who I am and what kind of life I want.",
            "language": "en",
            "verification": "curated",
            "theme": "development",
            "import": {
              "batch": "2026-09-14",
