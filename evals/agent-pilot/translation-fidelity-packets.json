          "display_role": "quote card",
          "fit": "not_checked",
          "source": {
            "id": "A4B08362-CB12-5387-926A-3EC5205F0851",
            "category": "affirmations",
            "text": "I see wealth as room to be useful.",
            "attribution": null,
            "language": "en",
            "context": null,
            "theme": "wealth_mindset",
            "pairId": "affirmations-0075",
            "source": null,
            "verification": "authored"
          },
          "candidate_hash": "db2c8c0e991d3557c3fc112001fe7d748fcdd700a0b3e7fcb95c5cfab9f8002e",
          "canonical": null
        },
        {
          "id": "s005",
          "text": "Senkinek sem szabad megmondania nekem, mit érzek magammal kapcsolatban; csak én dönthetem el, ki vagyok, és milyen életet akarok.",
