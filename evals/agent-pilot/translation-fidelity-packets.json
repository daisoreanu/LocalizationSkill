          "display_role": "quote card",
          "fit": "not_checked",
          "source": {
            "id": "2B6BB4B5-9C4A-58DB-8536-3D0481193BA8",
            "category": "affirmations",
            "text": "I use my budget as a map, not a punishment.",
            "attribution": null,
            "language": "en",
            "context": null,
            "theme": "financial",
            "pairId": "affirmations-0053",
            "source": null,
            "verification": "authored"
          },
          "candidate_hash": "6a7fcf14f58d933d468e8f508ca038536a7ef76124b332771dd4659f49d61e8a",
          "canonical": null
        },
