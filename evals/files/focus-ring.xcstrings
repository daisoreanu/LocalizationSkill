    "paywall.hero.reclaimFormat" : {
      "comment" : "Paywall hero headline. Placeholder is a duration like '3h a day'. Keep 'up to' — this is a target, not a promise",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take back up to %@."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recuperează până la %@."
          }
        }
      }
    },
    "widgets.focusRing.a11y.firstRun" : {
      "comment" : "Focus Goal widget: VoiceOver label for a user who has never run a session; %lld is the goal in minutes",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No focus sessions yet. Your daily goal is %lld minutes."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Încă nicio sesiune de concentrare. Obiectivul tău zilnic este %lld min."
          }
        }
      }
    },
    "widgets.focusRing.a11y.goalMet" : {
